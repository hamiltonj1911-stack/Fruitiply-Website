{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price",
          "disabled": true
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          },
          "disabled": true
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "disabled": true
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          },
          "disabled": true
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "virtue": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign virtue = product.metafields.fruitiply.virtue.value -%}{%- if virtue != blank -%}<p class=\"product__text caption-with-letter-spacing\">{{ virtue | escape }}</p>{%- endif -%}"
          }
        }
      },
      "block_order": [
        "virtue",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "juice-details": {
      "type": "juice-details",
      "blocks": {
        "availability": {
          "type": "availability"
        },
        "color_name": {
          "type": "color_name"
        },
        "retailer": {
          "type": "retailer"
        },
        "flavor": {
          "type": "flavor"
        },
        "ingredients": {
          "type": "ingredients"
        },
        "lesson": {
          "type": "lesson"
        },
        "nutrition": {
          "type": "nutrition"
        },
        "allergens": {
          "type": "allergens"
        }
      },
      "block_order": [
        "availability",
        "color_name",
        "retailer",
        "flavor",
        "ingredients",
        "lesson",
        "nutrition",
        "allergens"
      ],
      "settings": {
        "heading": "About this juice",
        "heading_size": "h1",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main",
    "juice-details",
    "disclosures",
    "related-products"
  ]
}
