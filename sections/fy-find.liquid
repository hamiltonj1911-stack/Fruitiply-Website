{% comment %}
  Fruitiply "Where to Find Us" card: text on the left, image (or decorative
  map placeholder) on the right.
{% endcomment %}

<section class="fy fy-find" id="{{ section.settings.anchor | default: 'find' | handleize }}" aria-labelledby="FyFindHeading-{{ section.id }}">
  <div class="fy-wrap">
    <div class="fy-find__card">
      <div class="fy-find__copy">
        <h2 id="FyFindHeading-{{ section.id }}">
          {{- section.settings.heading | escape }}
          {% if section.settings.heading_italic != blank %}<em>{{ section.settings.heading_italic | escape }}</em>{% endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <div class="fy-find__body">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="fy-find__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.image != blank -%}
        <div class="fy-find__visual">
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 820px) 50vw, 100vw',
              widths: '400, 600, 800, 1000',
              alt: section.settings.image.alt
          }}
        </div>
      {%- else -%}
        <div class="fy-find__visual" aria-hidden="true">🗺️</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Where to find us",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coming Soon —" },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic ending", "default": "Where to Find Us" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "note", "label": "Small note" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty for the map placeholder." },
    { "type": "text", "id": "anchor", "label": "Link anchor", "info": "Menu links to #find jump here.", "default": "find" }
  ],
  "presets": [{ "name": "Where to find us" }]
}
{% endschema %}
