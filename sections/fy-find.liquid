{% comment %}
  Fruitiply first access (Act III): pre-launch anticipation card. Invites
  visitors to be first to know when Fruitiply becomes available. Replace
  with retailer information only once Fruitiply is actually in stores.
{% endcomment %}

<section class="fy fy-find" id="{{ section.settings.anchor | default: 'first-access' | handleize }}" aria-labelledby="FyFindHeading-{{ section.id }}">
  <div class="fy-wrap">
    <div class="fy-find__card">
      <div class="fy-find__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="fy-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="FyFindHeading-{{ section.id }}">
          {{- section.settings.heading | escape }}
          {% if section.settings.heading_italic != blank %}<em>{{ section.settings.heading_italic | escape }}</em>{% endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <div class="fy-find__body">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="fy-btn fy-btn--dark" href="{{ section.settings.button_link | default: '#join' }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="fy-find__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
      <div class="fy-find__visual">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 820px) 50vw, 100vw',
              widths: '500, 700, 900, 1200',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          <div class="fy-find__placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fruitiply first access",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Pre-launch section. Don't list stores or say Fruitiply is in stores until that's true." },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Coming Soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be First" },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic ending", "default": "to Know" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get first access" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to jump to the signup section." },
    { "type": "textarea", "id": "note", "label": "Small note" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "anchor", "label": "Link anchor", "info": "Menu links to #first-access jump here.", "default": "first-access" }
  ],
  "presets": [{ "name": "Fruitiply first access" }]
}
{% endschema %}
