{% comment %}
  Fruitiply "Join the Community": newsletter signup (Shopify customer form,
  saved as a subscribed customer tagged "newsletter") and contact form
  (Shopify contact form, emailed to the store). Shopify adds spam protection.
  After submitting, Shopify reloads the page at this form with a success or
  error message.
{% endcomment %}

{%- liquid
  assign newsletter_id = 'FyNewsletter-' | append: section.id
  assign contact_id = 'FyContact-' | append: section.id
-%}

<section class="fy fy--dark fy-connect" id="{{ section.settings.anchor | default: 'join' | handleize }}" aria-labelledby="FyConnectHeading-{{ section.id }}">
  <div class="fy-wrap">
    <div class="fy-section-head">
      <h2 id="FyConnectHeading-{{ section.id }}">
        {{- section.settings.heading | escape }}
        {% if section.settings.heading_italic != blank %}<em>{{ section.settings.heading_italic | escape }}</em>{% endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="fy-benefits">
        {%- if section.settings.benefits_heading != blank -%}
          <h3 class="fy-benefits__heading">{{ section.settings.benefits_heading | escape }}</h3>
        {%- endif -%}
        <ul class="fy-benefits__list" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <strong>{{ block.settings.title | escape }}</strong>
              {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="fy-connect__grid">
      {%- if section.settings.show_newsletter -%}
        <div>
          <h3>{{ section.settings.newsletter_heading | escape }}</h3>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="fy-connect__sub">{{ section.settings.newsletter_text | escape }}</p>
          {%- endif -%}
          {%- form 'customer', id: newsletter_id -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="fy-field">
              <label for="{{ newsletter_id }}-email">{{ section.settings.newsletter_label | escape }}</label>
              <input
                type="email"
                id="{{ newsletter_id }}-email"
                name="contact[email]"
                required
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                placeholder="you@example.com"
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="{{ newsletter_id }}-msg"
                {% elsif form.posted_successfully? %}
                  aria-describedby="{{ newsletter_id }}-msg"
                {% endif %}
              >
            </div>
            <button type="submit" class="fy-btn fy-btn--gold">{{ section.settings.newsletter_button | escape }}</button>
            {%- if form.posted_successfully? -%}
              <p class="fy-form-msg fy-form-msg--ok" id="{{ newsletter_id }}-msg" role="status" tabindex="-1" autofocus>
                {{ section.settings.newsletter_success | escape }}
              </p>
            {%- elsif form.errors -%}
              <div class="fy-form-msg fy-form-msg--err" id="{{ newsletter_id }}-msg" role="alert" tabindex="-1" autofocus>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_contact -%}
        <div>
          <h3>{{ section.settings.contact_heading | escape }}</h3>
          {%- if section.settings.contact_text != blank -%}
            <p class="fy-connect__sub">{{ section.settings.contact_text | escape }}</p>
          {%- endif -%}
          {%- form 'contact', id: contact_id -%}
            <div class="fy-field">
              <label for="{{ contact_id }}-name">{{ 'templates.contact.form.name' | t }}</label>
              <input type="text" id="{{ contact_id }}-name" name="contact[name]" required autocomplete="name" value="{{ form.name }}">
            </div>
            <div class="fy-field">
              <label for="{{ contact_id }}-email">{{ 'templates.contact.form.email' | t }}</label>
              <input
                type="email"
                id="{{ contact_id }}-email"
                name="contact[email]"
                required
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ contact_id }}-msg"{% endif %}
              >
            </div>
            <div class="fy-field">
              <label for="{{ contact_id }}-body">{{ section.settings.contact_message_label | escape }}</label>
              <textarea id="{{ contact_id }}-body" name="contact[body]" rows="4" required>{{ form.body }}</textarea>
            </div>
            <button type="submit" class="fy-btn fy-btn--gold">{{ section.settings.contact_button | escape }}</button>
            {%- if form.posted_successfully? -%}
              <p class="fy-form-msg fy-form-msg--ok" id="{{ contact_id }}-msg" role="status" tabindex="-1" autofocus>
                {{ section.settings.contact_success | escape }}
              </p>
            {%- elsif form.errors -%}
              <div class="fy-form-msg fy-form-msg--err" id="{{ contact_id }}-msg" role="alert" tabindex="-1" autofocus>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fruitiply join + contact",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the" },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic ending", "default": "Community" },
    { "type": "textarea", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "anchor", "label": "Link anchor", "info": "Links to #join jump here.", "default": "join" },
    { "type": "text", "id": "benefits_heading", "label": "Member benefits heading", "default": "What members get" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Get the Good News First" },
    { "type": "textarea", "id": "newsletter_text", "label": "Text" },
    { "type": "text", "id": "newsletter_label", "label": "Field label", "default": "Email address" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Sign Up" },
    { "type": "text", "id": "newsletter_success", "label": "Success message", "default": "Thank you — you're on the list." },
    { "type": "header", "content": "Contact form" },
    { "type": "paragraph", "content": "Messages are emailed to the store's sender email (Settings > Notifications)." },
    { "type": "checkbox", "id": "show_contact", "label": "Show contact form", "default": true },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Say Hello" },
    { "type": "textarea", "id": "contact_text", "label": "Text" },
    { "type": "text", "id": "contact_message_label", "label": "Message field label", "default": "Message" },
    { "type": "text", "id": "contact_button", "label": "Button label", "default": "Send Message" },
    { "type": "text", "id": "contact_success", "label": "Success message", "default": "Message sent. We'll be in touch soon — thank you for reaching out." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Member benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Benefit" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Fruitiply join + contact" }]
}
{% endschema %}
