{% comment %}
  Fruitiply juice cards. Each card is built from a product in the chosen
  collection and its fruitiply.* metafields (virtue, color, color_name,
  flavor, ingredients, lesson, availability_status). Draft products never
  appear. Empty fields are skipped.
{% endcomment %}

{%- liquid
  assign juice_collection = section.settings.collection
  if juice_collection == blank
    assign juice_collection = collections.all
  endif
-%}

<section class="fy fy-juices" id="{{ section.settings.anchor | default: 'juices' | handleize }}" aria-labelledby="FyJuicesHeading-{{ section.id }}">
  <div class="fy-wrap">
    <div class="fy-section-head">
      <h2 id="FyJuicesHeading-{{ section.id }}">
        {{- section.settings.heading | escape }}
        {% if section.settings.heading_italic != blank %}<em>{{ section.settings.heading_italic | escape }}</em>{% endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="fy-juice-grid" role="list">
      {%- for product in juice_collection.products limit: section.settings.limit -%}
        {%- liquid
          assign juice = product.metafields.fruitiply
          assign virtue = juice.virtue.value | default: product.title
          assign status = juice.availability_status.value
          case status
            when 'available_in_stores'
              assign status_label = section.settings.label_in_stores
              assign status_class = 'available'
            when 'available_online'
              assign status_label = section.settings.label_online
              assign status_class = 'available'
            when 'coming_soon'
              assign status_label = section.settings.label_coming_soon
              assign status_class = 'soon'
            else
              assign status_label = blank
          endcase
        -%}
        <li>
          <article
            class="fy-juice fy-reveal"
            {% if juice.color != blank %}style="--juice-color: {{ juice.color.value }};"{% endif %}
          >
            <div class="fy-juice__top">
              <span class="fy-juice__dot" aria-hidden="true">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 52, height: 52 }}
                {%- endif -%}
              </span>
              {%- if status_label != blank -%}
                <span class="fy-status fy-status--{{ status_class }}">{{ status_label | escape }}</span>
              {%- endif -%}
            </div>
            <h3><a href="{{ product.url }}">{{ virtue | escape }}</a></h3>
            {%- if juice.color_name != blank -%}
              <p class="fy-juice__color">{{ juice.color_name.value | escape }}</p>
            {%- endif -%}
            {%- if juice.flavor != blank -%}
              <p class="fy-juice__flavor">{{ juice.flavor.value | escape | newline_to_br }}</p>
            {%- endif -%}
            {%- if juice.ingredients.value.size > 0 -%}
              <p class="fy-juice__ingredients">
                <strong>{{ section.settings.label_ingredients | escape }}:</strong>
                {{ juice.ingredients.value | join: ' · ' | escape }}
              </p>
            {%- endif -%}
            {%- if juice.lesson != blank -%}
              <p class="fy-juice__lesson">
                <span>{{ section.settings.label_lesson | escape }}</span>
                {{- juice.lesson.value | escape | newline_to_br -}}
              </p>
            {%- endif -%}
          </article>
        </li>
      {%- else -%}
        {%- comment -%} No products yet: show placeholder cards so the layout is visible in the editor. {%- endcomment -%}
        {%- for i in (1..3) -%}
          <li>
            <article class="fy-juice">
              <div class="fy-juice__top">
                <span class="fy-juice__dot" aria-hidden="true"></span>
                <span class="fy-status fy-status--soon">{{ section.settings.label_coming_soon | escape }}</span>
              </div>
              <h3>Juice name</h3>
              <p class="fy-juice__color">Color name</p>
              <p class="fy-juice__flavor">Add juices as products, fill in their Fruitiply metafields, then pick their collection in this section.</p>
            </article>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Fruitiply juice cards",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Nine" },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic ending", "default": "Juices" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Each bottle is named for a Fruit of the Spirit and carries its own color, character, and lesson."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Juice collection",
      "info": "Cards show in the collection's sort order. Leave empty to show all products."
    },
    { "type": "range", "id": "limit", "label": "Maximum juices", "min": 3, "max": 12, "step": 1, "default": 9 },
    { "type": "text", "id": "anchor", "label": "Link anchor", "info": "Menu links to #juices jump here.", "default": "juices" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "label_in_stores", "label": "Available in stores", "default": "In Stores" },
    { "type": "text", "id": "label_online", "label": "Available online", "default": "Available Online" },
    { "type": "text", "id": "label_coming_soon", "label": "Coming soon", "default": "Coming Soon" },
    { "type": "text", "id": "label_ingredients", "label": "Ingredients label", "default": "Ingredients" },
    { "type": "text", "id": "label_lesson", "label": "Lesson label", "default": "The Lesson" }
  ],
  "presets": [{ "name": "Fruitiply juice cards" }]
}
{% endschema %}
