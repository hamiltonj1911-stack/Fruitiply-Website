{% comment %}
  Fruitiply header: text or image logo, menu, "Join the Community" button,
  and the optional floating-fruit background. On phones the menu collapses
  behind a Menu button.
{% endcomment %}

{%- if section.settings.show_wallpaper -%}
  {%- render 'fy-wallpaper' -%}
{%- endif -%}

<header class="fy fy-header">
  <div class="fy-header__inner">
    <a class="fy-logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round -%}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            width: section.settings.logo_width,
            height: logo_height,
            alt: shop.name,
            loading: 'eager'
        }}
      {%- else -%}
        {{- section.settings.logo_text | escape -}}
        {%- if section.settings.logo_text_accent != blank -%}<em>{{ section.settings.logo_text_accent | escape }}</em>{%- endif -%}
        {{- section.settings.logo_text_suffix | escape -}}
      {%- endif -%}
    </a>

    <nav class="fy-nav" aria-label="{{ 'sections.header.menu' | t }}">
      {%- if section.settings.menu.links.size > 0 -%}
        <button
          class="fy-nav__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="FyNavLinks-{{ section.id }}"
          data-fy-nav-toggle
        >
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.5" fill="none"/>
          </svg>
          {{ 'sections.header.menu' | t }}
        </button>
        <ul class="fy-nav__links" id="FyNavLinks-{{ section.id }}" role="list">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="fy-nav__cta" href="{{ section.settings.cta_link | default: '#join' }}">
          {{- section.settings.cta_label | escape -}}
        </a>
      {%- endif -%}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Fruitiply header",
  "class": "fy-header-section",
  "settings": [
    { "type": "header", "content": "Logo" },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave empty to use the text logo below."
    },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "text", "id": "logo_text", "label": "Text logo", "default": "Fruit" },
    { "type": "text", "id": "logo_text_accent", "label": "Text logo: italic gold part", "default": "iply" },
    { "type": "text", "id": "logo_text_suffix", "label": "Text logo: ending", "default": "." },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Join the Community" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave empty to jump to the signup section on the home page." },
    { "type": "header", "content": "Background" },
    {
      "type": "checkbox",
      "id": "show_wallpaper",
      "label": "Show floating fruit background",
      "info": "Gentle animated fruit behind the page. Automatically hidden for visitors who turn off motion on their device.",
      "default": true
    }
  ]
}
{% endschema %}
