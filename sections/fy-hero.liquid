{% comment %}
  Fruitiply hero: eyebrow, two-line headline (second line italic), intro,
  up to three buttons, and either the animated tree or an uploaded image.
{% endcomment %}

<section class="fy fy-hero" id="top" aria-labelledby="FyHeroHeading-{{ section.id }}">
  <div class="fy-wrap fy-hero__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="fy-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="FyHeroHeading-{{ section.id }}">
        {{- section.settings.heading_line_1 | escape -}}
        {%- if section.settings.heading_line_2 != blank -%}
          <br><em>{{ section.settings.heading_line_2 | escape }}</em>
        {%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="fy-hero__lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="fy-hero__buttons">
          {%- for block in section.blocks -%}
            <a
              class="fy-btn {% if block.settings.style == 'solid' %}fy-btn--dark{% else %}fy-btn--line{% endif %}"
              href="{{ block.settings.link | default: '#' }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | escape -}}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="fy-hero__visual">
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 900px) 40vw, 90vw',
            widths: '400, 600, 800, 1000, 1200',
            alt: section.settings.image.alt
        }}
        {%- render 'fy-hero-badge', section: section -%}
      </div>
    {%- else -%}
      <div class="fy-hero__visual" role="img" aria-label="{{ section.settings.tree_alt | escape }}">
        {%- render 'fy-tree' -%}
        {%- render 'fy-hero-badge', section: section -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fruitiply hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Premium Cold-Pressed Juice · Nine Fruits of the Spirit" },
    { "type": "text", "id": "heading_line_1", "label": "Heading, line 1", "default": "Grow Good." },
    { "type": "text", "id": "heading_line_2", "label": "Heading, line 2 (italic)", "default": "Multiply Good." },
    { "type": "textarea", "id": "text", "label": "Intro text", "default": "Nine cold-pressed juices, each named for a Fruit of the Spirit — crafted to nourish your body, grow your habits, and gather your people around something good." },
    { "type": "header", "content": "Visual" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to show the animated tree."
    },
    { "type": "text", "id": "tree_alt", "label": "Animated tree description (for screen readers)", "default": "Animated tree bearing nine fruits, with gentle spirits rising around it" },
    { "type": "text", "id": "badge_title", "label": "Badge title", "default": "Nine Juices. Nine Virtues." },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "One good habit at a time." }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Explore the Juices" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fruitiply hero",
      "blocks": [
        { "type": "button", "settings": { "label": "Explore the Juices", "link": "#juices", "style": "solid" } },
        { "type": "button", "settings": { "label": "Our Story", "link": "#story", "style": "outline" } },
        { "type": "button", "settings": { "label": "Join the Community", "link": "#join", "style": "outline" } }
      ]
    }
  ]
}
{% endschema %}
