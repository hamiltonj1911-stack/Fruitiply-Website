{% comment %}
  Fruitiply hero (Act I): eyebrow, "Grow Good. Multiply Good." headline
  (second line italic), intro, up to three buttons, and a large product image
  (carton, produce, condensation). Until a photo is added, a soft sunlit
  placeholder panel shows instead.
{% endcomment %}

<section class="fy fy-hero" id="top" aria-labelledby="FyHeroHeading-{{ section.id }}">
  <div class="fy-wrap fy-hero__grid">
    <div class="fy-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fy-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="FyHeroHeading-{{ section.id }}">
        {{- section.settings.heading_line_1 | escape -}}
        {%- if section.settings.heading_line_2 != blank -%}
          <br><em>{{ section.settings.heading_line_2 | escape }}</em>
        {%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="fy-hero__lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="fy-hero__buttons">
          {%- for block in section.blocks -%}
            <a
              class="fy-btn {% if block.settings.style == 'solid' %}fy-btn--dark{% else %}fy-btn--line{% endif %}"
              href="{{ block.settings.link | default: '#' }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | escape -}}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="fy-hero__visual">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 900px) 50vw, 100vw',
            widths: '500, 700, 900, 1200, 1600',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        <div class="fy-hero__placeholder" aria-hidden="true"></div>
      {%- endif -%}
      {%- if section.settings.badge_title != blank or section.settings.badge_text != blank -%}
        <div class="fy-hero__badge">
          {%- if section.settings.badge_title != blank -%}
            <strong>{{ section.settings.badge_title | escape }}</strong>
          {%- endif -%}
          {{- section.settings.badge_text | escape -}}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fruitiply hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Premium Cold-Pressed Juice" },
    { "type": "text", "id": "heading_line_1", "label": "Heading, line 1", "default": "Grow Good." },
    { "type": "text", "id": "heading_line_2", "label": "Heading, line 2 (italic)", "default": "Multiply Good." },
    { "type": "textarea", "id": "text", "label": "Intro text" },
    { "type": "header", "content": "Image" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Carton or bottle with fresh produce, texture, light. Tall (4:5) or square images work best. Add alt text in the image settings."
    },
    { "type": "text", "id": "badge_title", "label": "Badge title", "info": "Small card over the image. Leave empty to hide." },
    { "type": "text", "id": "badge_text", "label": "Badge text" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Explore the Juices" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fruitiply hero",
      "blocks": [
        { "type": "button", "settings": { "label": "Explore the Juices", "link": "#juices", "style": "solid" } },
        { "type": "button", "settings": { "label": "Our Story", "link": "#story", "style": "outline" } }
      ]
    }
  ]
}
{% endschema %}
