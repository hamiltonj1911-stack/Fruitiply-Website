{% comment %}
  Custom 404 page (Fruitiply design). Replaces Dawn's main-404 so the
  heading, message and links are editable in the theme editor.
{% endcomment %}

<div class="fy fy-404">
  {%- if section.settings.show_tree -%}
    <div class="fy-404__tree" aria-hidden="true">🌳🍃</div>
  {%- endif -%}
  {%- if section.settings.caption != blank -%}
    <p class="fy-eyebrow">{{ section.settings.caption | escape }}</p>
  {%- endif -%}
  <h1>
    {{- section.settings.heading | escape }}
    {% if section.settings.heading_italic != blank %}<em>{{ section.settings.heading_italic | escape }}</em>{% endif -%}
    {{- section.settings.heading_end | escape -}}
  </h1>
  {%- if section.settings.text != blank -%}
    <p class="fy-404__text">{{ section.settings.text | escape }}</p>
  {%- endif -%}
  {%- if section.settings.button_label_1 != blank -%}
    <a href="{{ section.settings.button_link_1 | default: routes.root_url }}" class="fy-btn fy-btn--dark">
      {{- section.settings.button_label_1 | escape -}}
    </a>
  {%- endif -%}
  {%- if section.settings.button_label_2 != blank -%}
    <a href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}" class="fy-404__plain">
      {{- section.settings.button_label_2 | escape -}}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "404 message",
  "tag": "section",
  "enabled_on": {
    "templates": ["404"]
  },
  "settings": [
    { "type": "checkbox", "id": "show_tree", "label": "Show swaying tree", "default": true },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Error 404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This branch has" },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic part", "default": "no fruit" },
    { "type": "text", "id": "heading_end", "label": "Heading, ending", "default": " on it." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Message",
      "default": "The page you're looking for may have moved, been pressed out of rotation, or never existed. Let's get you back to the good stuff."
    },
    { "type": "text", "id": "button_label_1", "label": "Button label", "default": "Return to the Grove" },
    { "type": "url", "id": "button_link_1", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second link label", "default": "Explore the Juices" },
    { "type": "url", "id": "button_link_2", "label": "Second link" }
  ],
  "presets": [{ "name": "404 message" }]
}
{% endschema %}
